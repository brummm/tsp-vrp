 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Project 2: Medical Route Optimization\n",
    "\n",
    "This notebook demonstrates the Genetic Algorithm solution for the Vehicle Routing Problem (VRP) in a medical delivery context."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "\n",
    "from src.models.location import Location\n",
    "from src.algorithms.genetic_optimizer import GeneticOptimizer\n",
    "from src.utils.plotter import Plotter\n",
    "from src.llm.report_generator import ReportGenerator\n",
    "from src.utils.data_loader import DataLoader"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Define Problem Data\n",
    "depot = Location(0, 50, 50, \"Central Depot\")\n",
    "\n",
    "# Select dataset: 'small', 'medium', or 'large'\n",
    "DATASET = 'small'\n",
    "\n",
    "file_map = {\n",
    "    'small': '../data/locations_small.json',\n",
    "    'medium': '../data/locations_medium.json',\n",
    "    'large': '../data/locations_large.json'\n",
    "}\n",
    "\n",
    "locations = DataLoader.load_locations(file_map[DATASET])\n",
    "\n",
    "vehicle_capacity = 4 # Can carry 4 units (assuming demand=1 for all)\n",
    "\n",
    "print(f\"Loaded {len(locations)} locations from {DATASET} dataset.\")\n",
    "print(f\"Vehicle Capacity: {vehicle_capacity}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Run Genetic Algorithm\n",
    "# Adjust generations/pop_size based on problem size if needed\n",
    "generations = 200 if DATASET == 'large' else 150\n",
    "pop_size = 100 if DATASET == 'large' else 60\n",
    "\n",
    "optimizer = GeneticOptimizer(locations, depot, vehicle_capacity, generations=generations, pop_size=pop_size)\n",
    "best_routes, best_dist = optimizer.run()\n",
    "\n",
    "print(f\"Best Total Distance: {best_dist:.2f}\")\n",
    "print(f\"Total Vehicles Used: {len(best_routes)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Visualize Solution\n",
    "Plotter.plot_solution(best_routes, depot)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Generate LLM Report\n",
    "llm = ReportGenerator() # Will use mock if no API key\n",
    "\n",
    "print(\"Generating Instructions for Drivers...\\n\")\n",
    "\n",
    "# Limit output for large datasets to avoid spamming the notebook\n",
    "max_reports = 3 if DATASET == 'large' else 100\n",
    "\n",
    "for i, route in enumerate(best_routes[:max_reports]):\n",
    "    print(llm.generate_driver_instructions(i, route))\n",
    "    print(\"\\n\" + \"=\""*40 + \"\\n\")\n",
    "\n",
    "if len(best_routes) > max_reports:\n",
    "    print(f\"... and {len(best_routes) - max_reports} more routes.\")"
   ]
  }
 ],
